{
  "name": "wtc7",
  "version": "0.1.0",
  "private": true,
  "description": "Staged finite-element re-analysis of WTC 7 (Phase 1: column 79 floor framing)",
  "scripts": {
    "start": "npm run serve",
    "serve": "echo \"Open http://127.0.0.1:8765/ (Plain-English Guide, Forensic Report & 3D Viewer)\" && python3 -m http.server 8765 --bind 127.0.0.1 --directory reports/forensic",
    "guide": "python3 -c \"import pathlib, webbrowser; webbrowser.open(pathlib.Path('reports/forensic/index.html').resolve().as_uri())\"",
    "report": "python3 -c \"import pathlib, webbrowser; webbrowser.open(pathlib.Path('reports/forensic/index.html').resolve().as_uri() + '#tab=report')\"",
    "viewer": "python3 -c \"import pathlib, webbrowser; webbrowser.open(pathlib.Path('reports/forensic/index.html').resolve().as_uri() + '#layout=3d')\"",
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && .venv/bin/pip install -e .",
    "test": ".venv/bin/python -m pytest -q tests",
    "hand-calcs": ".venv/bin/python phase1/hand_calcs.py",
    "build:viewer": ".venv/bin/python scripts/export_viewer.py",
    "build:report": ".venv/bin/python scripts/build_report.py",
    "build": "npm run build:viewer && npm run build:report",
    "verify:sources": "scripts/fetch_sources.sh && scripts/fetch_drawings.sh"
  }
}
